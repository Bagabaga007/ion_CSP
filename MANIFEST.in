prune .claude
prune .github
prune .vscode

include README.md
include LICENSE
include CHANGELOG.md
include MANIFEST.in
include pyproject.toml
include setup.py
include setup.cfg
include uv.lock
include environment.yml
include environment-mlp.yml
include AUTO_LINKING_GUIDE.md
include DOCKER.md
include DPA4_BACKEND.md
include MATTERSIM_BACKEND.md
include Dockerfile
include Dockerfile.gpu
include docker-compose.yml
include .dockerignore
recursive-include config *
recursive-include docs *
recursive-include examples *
recursive-include tests *
recursive-include scripts *
recursive-include delivery *
exclude delivery/release-manifest.json
prune delivery/candidate-manifests
recursive-include src/ion_CSP *
prune docs/history
exclude examples/server/example_remote_machine.yaml
exclude .coveragerc .gitignore pyrightconfig.json
exclude CODE_OF_CONDUCT.md CONTRIBUTING.md SECURITY.md
exclude makefile run_tests.sh
global-exclude *.orig *.pyc *.pyo .DS_Store
