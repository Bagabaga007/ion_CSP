[run]
source = src/ion_CSP
# mlp_opt.py 使用 multiprocessing.Pool，需要开启以下选项，
# coverage 才能正确合并子进程的覆盖率数据并清理临时文件，
# 否则会在项目根目录残留 .coverage.<host>.<pid>.<random> 文件。
parallel = True
concurrency = multiprocessing
sigterm = True
omit =
    */tests/*
    */test_*.py
    setup.py
    */__pycache__/*
    */__init__.py
    */__main__.py

[report]
precision = 2
show_missing = True
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    if __name__ == "__main__":
    if TYPE_CHECKING:
    raise AssertionError
    raise NotImplementedError
    @abstractmethod
    @abc.abstractmethod

[html]
directory = htmlcov

[xml]
output = coverage.xml
