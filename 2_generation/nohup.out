# Unit cell and primitive cell were written in "phonopy_symcells.yaml".
# These structures can be read in a python script as follows:
#
# from phonopy.interface.phonopy_yaml import read_cell_yaml
# unitcell = read_cell_yaml("phonopy_symcells.yaml", "unitcell")
# primitive_cell = read_cell_yaml("phonopy_symcells.yaml", "primitive")
